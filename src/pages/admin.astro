---
// Este archivo sirve la interfaz de Decap CMS y evita conflictos con el enrutador de Starlight
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Administración de Documentación</title>
    <!-- Ruta explícita al archivo de configuración para evitar errores de 404 -->
    <link rel="cms-config-url" type="text/yaml" href="/admin/config.yml" />
    <!-- Incluir el script de Netlify Identity para el inicio de sesión -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <!-- Script de Decap CMS -->
    <script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
  </body>
</html>
